!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - asp_presentacion</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/asp_presentacion.styles.css" asp-append-version="true" />
    <style>
        /* Estilos básicos para las imágenes en la navegación */
        .navbar-nav .nav-item img {
            height: 20px; /* Ajusta el tamaño según necesites */
            width: 20px; /* Ajusta el tamaño según necesites */
            margin-right: 5px; /* Espacio entre la imagen y el texto */
            vertical-align: middle; /* Alinea verticalmente con el texto */
        }
    </style>
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">
                                <img src="@Url.Content("~/imagenes/263115.png")" alt="home" /> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">
                                <img src="@Url.Content("~/imagenes/3064155.png")" alt="Privacy" /> Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Ventas">
                                <img src="@Url.Content("~/imagenes/20250525_0419_image.png")" alt="Ventas" /> Ventas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Empleados">
                                <img src="@Url.Content("~/imagenes/20250525_0410_image.png")" alt="Empleados" /> Empleados
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Pedidos">
                                <img src="@Url.Content("~/imagenes/gestion-de-pedidos1.jpg")" alt="Pedidos" /> Pedidos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Usuarios">
                                <img src="@Url.Content("~/imagenes/20250525_0417_image.png")" alt="Usuarios" /> Usuarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Roles">
                                <img src="@Url.Content("~/imagenes/20250525_0417_image.png")" alt="Roles" /> Roles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Estantes">
                                <img src="@Url.Content("~/imagenes/20250525_0353_image.png")" alt="Estantes" /> Estantes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/DetallesVentas">
                                <img src="@Url.Content("~/imagenes/20250525_0419_image (1).png")" alt="DetallesVentas" /> DetallesVentas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Juguetes">
                                <img src="@Url.Content("~/imagenes/4df467d319257597d4d3108772b756df.png")" alt="Juguetes" /> Juguetes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Proveedores">
                                <img src="@Url.Content("~/imagenes/proveedores-e1663621176409.jpeg")" alt="Proveedores" /> Proveedores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-page="/Ventanas/Permisos">
                                <img src="@Url.Content("~/imagenes/3.jpg")" alt="Permisos" /> Permisos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - asp_presentacion - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>