@page
@model asp_presentaciones.Pages.Ventanas.JuguetesModel
@{
    ViewData["Titulo"] = "Juguetes";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Juguetes</h3>
            </div>
            <div align="left" class="bt_panel_buttons">
                <input type="submit" value="Refrescar" asp-page-handler="BtRefrescar" class="btn btn-secondary" disabled="@(Model.Accion != lib_dominio.Nucleo.Enumerables.Ventanas.Listas)" />
                <input type="submit" value="Nuevo" asp-page-handler="BtNuevo" class="btn btn-secondary" disabled="@(Model.Accion != lib_dominio.Nucleo.Enumerables.Ventanas.Listas)" />
                <input type="submit" value="Guardar" asp-page-handler="BtGuardar" class="btn btn-secondary" disabled="@(Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Listas)" />
                <input type="submit" value="Cancelar" asp-page-handler="BtCancelar" class="btn btn-secondary" disabled="@(Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Listas)" />
            </div>

            @if (Model.Accion != lib_dominio.Nucleo.Enumerables.Ventanas.Listas || Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Borrar)
            {
                <input type="hidden" asp-for="@Model.Actual!.Id" />
                <img src="@Url.Content("~/imagenes/4df467d319257597d4d3108772b756df.png")" alt="Juguetes" />
            }
            @if (Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Borrar)
            {
                <input type="hidden" asp-for="@Model.Actual!.Nombre" />
                <input type="hidden" asp-for="@Model.Actual!.Descripcion" />
                <input type="hidden" asp-for="@Model.Actual!.Precio" />
                <input type="hidden" asp-for="@Model.Actual!.Stock" />
                <input type="hidden" asp-for="@Model.Actual!.estantes" />
            }

            @if (Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Editar || Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Editar)
            {
                <div class="containers_vn panel panel-default">
                    <h3>Juguete</h3>
                    <div class="form-group">
                        <label class="col-lg-4 control-label">Nombre</label>
                        <div class="col-lg-6">
                            <input class="cts_forms form-control" asp-for="@Model.Actual!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label">Descripción</label>
                        <div class="col-lg-6">
                            <input class="cts_forms form-control" asp-for="@Model.Actual!.Descripcion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label">Stock</label>
                        <div class="col-lg-6">
                            <input type="number" class="cts_forms form-control" asp-for="@Model.Actual!.Stock" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label">Precio</label>
                        <div class="col-lg-6">
                            <input type="number" class="cts_forms form-control" asp-for="@Model.Actual!.Precio" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-4 control-label">Estante ID</label>
                        <div class="col-lg-6">
                            <select asp-for="Actual!.estantes"
                                    asp-items="@(new SelectList(Model.estante, "Id", "Nombre"))" class="form-control">
                                <option value="">Selecciona un Estante</option>
                                <option value="1">uno</option>
                                <option value="2">dos</option>
                                <option value="3">tres</option>
                            </select>
                        </div>
                    </div>

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                <input type="hidden" asp-for="@Model.Accion" />
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            }

            @if (Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Borrar)
            {
                <div class='popup'>
                    <div class='pp_del_inner'>
                        <div style='width:95%'>
                            <h2 align="left">Mensaje</h2>
                            <h4 align="left">Desea borrar el juguete?</h4>
                            <h6 align="left">Nombre:@Model.Actual!.Nombre ,Descripcion:@Model.Actual!.Descripcion,Stock:@Model.Actual!.Stock,Precio:@Model.Actual!.Precio,  Estante ID:@Model.Actual!.estantes</h6>
                            <br /><br />
                            <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-secondary" />
                            <input type="submit" value="Cerrar" asp-page-handler="BtCancelar" class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Listas || Model.Accion == lib_dominio.Nucleo.Enumerables.Ventanas.Borrar)
            {
                <div class="containers_vn panel panel-default">
                    <table class="tb_data table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Stock</th>
                                <th>Precio</th>
                                <th>ID Estante</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Lista != null)
                            {
                                @foreach (var elemento in Model.Lista)
                                {
                                    <tr>
                                        <td>@elemento.Nombre</td>
                                        <td>@elemento.Descripcion</td>
                                        <td>@elemento.Stock</td>
                                        <td>@elemento.Precio</td>
                                        <td>@elemento._Id_Estante!.Ubicacion</td>
                                        <td>
                                            <input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-secondary" asp-route-data="@elemento.Id" />
                                            <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-secondary" asp-route-data="@elemento.Id" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </form>
    </div>
</center>
